# Copy this file to .env and replace the example values.
# Keep .env out of Git; share real values through the team messenger.
SECRET_KEY=replace-with-a-long-random-string
MONGO_USER=gardevoir_dev
MONGO_PASSWORD=replace_this_password
MONGODB_URI=mongodb://gardevoir_dev:replace_this_password@localhost:27017/gardevoir_secondhand?authSource=admin
MONGODB_DB=gardevoir_secondhand
# Optional: an absolute photo directory shared by checkouts using the same database.
# If unset, photos are saved in this checkout's instance/uploads/ directory.
# UPLOAD_FOLDER=/absolute/path/to/shared-uploads
